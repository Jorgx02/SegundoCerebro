@page "/wellness"
@using SegundoCerebro.BlazorWasm.Models
@using MudBlazor
@using SegundoCerebro.BlazorWasm.Services
@inject IWellnessService WellnessService
@inject ISnackbar Snackbar

<PageTitle>Diario de Bienestar - SegundoCerebro</PageTitle>

<style>
    .card-outline {
        border: 1px solid var(--mud-palette-lines-default);
        background-color: var(--mud-palette-surface) !important;
        backdrop-filter: blur(12px);
    }
    
    .glow-bg {
        position: absolute;
        width: 150px;
        height: 150px;
        border-radius: 50%;
        filter: blur(80px);
        opacity: 0.15;
        pointer-events: none;
    }
</style>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4 mb-8">
    <!-- Header -->
    <div class="d-flex flex-column flex-md-row align-center justify-space-between mb-6">
        <div>
            <MudText Typo="Typo.h4" Style="font-weight: 700;">Diario de bienestar</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">Registra cómo te sientes cada día para encontrar patrones y mejorar tu bienestar general.</MudText>
        </div>
    </div>

    <MudGrid Spacing="4">
        <!-- Formulario -->
        <MudItem xs="12" md="5" lg="4">
            <MudCard Class="card-outline pa-4" Style="position: relative; overflow: hidden;">
                <div class="glow-bg" style="top: -50px; right: -50px; background-color: var(--mud-palette-secondary);"></div>
                
                <MudText Typo="Typo.h6" Style="font-weight: 700;" Class="mb-4">Registro de hoy</MudText>

                <MudDatePicker Label="Fecha de la entrada" @bind-Date="selectedDate" ReadOnly="true" Variant="Variant.Outlined"
                               DateFormat="dd MMM yyyy" Class="mb-6" />

                <MudText Typo="Typo.subtitle2" Style="font-weight: 700;" Class="mb-2">Estado de ánimo</MudText>
                <div class="d-flex justify-center gap-2 mb-6">
                    <MudIconButton Icon="@(model.MoodRating == 1 ? Icons.Material.Filled.SentimentVeryDissatisfied : Icons.Material.Outlined.SentimentVeryDissatisfied)"
                                   Color="@(model.MoodRating == 1 ? Color.Error : Color.Default)"
                                   OnClick="@(() => model.MoodRating = 1)" Size="Size.Large" />
                    <MudIconButton Icon="@(model.MoodRating == 2 ? Icons.Material.Filled.SentimentDissatisfied : Icons.Material.Outlined.SentimentDissatisfied)"
                                   Color="@(model.MoodRating == 2 ? Color.Warning : Color.Default)"
                                   OnClick="@(() => model.MoodRating = 2)" Size="Size.Large" />
                    <MudIconButton Icon="@(model.MoodRating == 3 ? Icons.Material.Filled.SentimentNeutral : Icons.Material.Outlined.SentimentNeutral)"
                                   Color="@(model.MoodRating == 3 ? Color.Info : Color.Default)"
                                   OnClick="@(() => model.MoodRating = 3)" Size="Size.Large" />
                    <MudIconButton Icon="@(model.MoodRating == 4 ? Icons.Material.Filled.SentimentSatisfied : Icons.Material.Outlined.SentimentSatisfied)"
                                   Color="@(model.MoodRating == 4 ? Color.Success : Color.Default)"
                                   OnClick="@(() => model.MoodRating = 4)" Size="Size.Large" />
                    <MudIconButton Icon="@(model.MoodRating == 5 ? Icons.Material.Filled.SentimentVerySatisfied : Icons.Material.Outlined.SentimentVerySatisfied)"
                                   Color="@(model.MoodRating == 5 ? Color.Primary : Color.Default)"
                                   OnClick="@(() => model.MoodRating = 5)" Size="Size.Large" />
                </div>

                <MudText Typo="Typo.subtitle2" Style="font-weight: 700;" Class="mb-2">Nivel de energía</MudText>
                <div class="d-flex justify-center mb-6">
                    <MudRating @bind-SelectedValue="model.EnergyLevel" MaxValue="5" Size="Size.Large" Color="Color.Warning"
                               EmptyIcon="@Icons.Material.Outlined.Battery0Bar" FullIcon="@Icons.Material.Filled.BatteryChargingFull" />
                </div>

                <MudTextField @bind-Value="model.Notes" Label="Notas del día (opcional)" Variant="Variant.Outlined" Lines="4"
                              Class="mb-6" Placeholder="¿Cómo te ha ido hoy? ¿Qué ha afectado tu energía o ánimo?" />

                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveEntry" Disabled="isSaving || isLoading" FullWidth="true" Size="Size.Large">
                    @if (isSaving)
                    {
                        <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                        <MudText Class="ms-2">Guardando...</MudText>
                    }
                    else
                    {
                        <MudText Style="font-weight: 600;">Guardar entrada</MudText>
                    }
                </MudButton>
            </MudCard>
        </MudItem>

        <!-- Historial Semanal -->
        <MudItem xs="12" md="7" lg="8">
            <MudCard Class="card-outline pa-4 h-100" Style="position: relative; overflow: hidden;">
                <div class="glow-bg" style="bottom: -50px; left: -50px; background-color: var(--mud-palette-info);"></div>
                
                <div class="d-flex justify-space-between align-center mb-6">
                    <MudText Typo="Typo.h6" Style="font-weight: 700;">Entradas recientes</MudText>
                    <MudChip Size="Size.Small" Color="Color.Surface" Variant="Variant.Filled" Style="border: 1px solid rgba(255,255,255,0.1);">
                        @currentWeekStart.ToString("dd MMM") - @currentWeekStart.AddDays(6).ToString("dd MMM")
                    </MudChip>
                </div>

                @if (isLoading)
                {
                    <div class="d-flex justify-center my-10">
                        <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
                    </div>
                }
                else if (weeklyEntries.Any())
                {
                    <MudStack Spacing="3">
                        @foreach (var entry in weeklyEntries.OrderByDescending(e => e.Date))
                        {
                            <MudPaper Elevation="0" Class="pa-4 d-flex align-start gap-4" Style="background-color: rgba(255,255,255,0.02); border: 1px solid rgba(255,255,255,0.05); border-radius: 8px;">
                                <div class="d-flex flex-column align-center mr-2" style="min-width: 60px;">
                                    <MudText Typo="Typo.h6" Style="font-weight: 700; color: var(--mud-palette-primary);">@entry.Date.ToString("dd")</MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary" Style="text-transform: uppercase;">@entry.Date.ToString("MMM")</MudText>
                                </div>
                                <div class="flex-grow-1">
                                    <div class="d-flex gap-4 mb-2 flex-wrap">
                                        <MudChip Size="Size.Small" Icon="@GetMoodIcon(entry.MoodRating)" Color="@GetMoodColor(entry.MoodRating)" Variant="Variant.Text" Style="font-weight: 600;">
                                            @GetMoodDescription(entry.MoodRating)
                                        </MudChip>
                                        <MudChip Size="Size.Small" Icon="@GetEnergyIcon(entry.EnergyLevel)" Color="@GetEnergyColor(entry.EnergyLevel)" Variant="Variant.Text" Style="font-weight: 600;">
                                            Energía: @GetRatingDescription(entry.EnergyLevel)
                                        </MudChip>
                                    </div>
                                    @if (!string.IsNullOrEmpty(entry.Notes))
                                    {
                                        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-1" Style="font-style: italic;">"@entry.Notes"</MudText>
                                    }
                                </div>
                            </MudPaper>
                        }
                    </MudStack>
                }
                else
                {
                    <div class="d-flex flex-column align-center justify-center h-100 pa-8 text-center" style="opacity: 0.7;">
                        <MudIcon Icon="@Icons.Material.Filled.SelfImprovement" Size="Size.Large" Class="mb-4" />
                        <MudText Typo="Typo.h6">Aún no hay registros esta semana</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-2">Comienza a registrar cómo te sientes hoy en el panel lateral.</MudText>
                    </div>
                }
            </MudCard>
        </MudItem>
    </MudGrid>
</MudContainer>

@code {
    private DateTime? selectedDate = DateTime.Today;
    private UpsertWellnessEntryDto model = new();
    private bool isSaving = false;
    private bool isLoading = true;

    private List<WellnessEntryDto> weeklyEntries = new();
    private DateTime currentWeekStart;

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        try
        {
            SetCurrentWeek(DateTime.Today);
            await LoadTodaysEntryInternal();
            await LoadWeeklyEntries();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al cargar la página", Severity.Error);
        }
        finally
        {
            isLoading = false;
            StateHasChanged(); 
        }
    }

    private async Task LoadTodaysEntryInternal()
    {
        var today = DateTime.Today;
        var entries = await WellnessService.GetByDateRangeAsync(today, today);
        var entry = entries.FirstOrDefault();

        if (entry != null)
        {
            model = new UpsertWellnessEntryDto
            {
                Date = entry.Date,
                MoodRating = entry.MoodRating,
                EnergyLevel = entry.EnergyLevel,
                Notes = entry.Notes
            };
        }
        else
        {
            model = new UpsertWellnessEntryDto { Date = today, MoodRating = 3, EnergyLevel = 3 };
        }
    }

    private async Task SaveEntry()
    {
        isSaving = true;
        model.Date = DateTime.Today; 
        try
        {
            var savedEntry = await WellnessService.UpsertAsync(model);
            Snackbar.Add("Entrada guardada con éxito.", Severity.Success);
            await LoadTodaysEntryInternal();
            await LoadWeeklyEntries();
            StateHasChanged();
        }
        catch (Exception ex) { Snackbar.Add($"Error al guardar la entrada", Severity.Error); }
        finally { isSaving = false; }
    }

    private void SetCurrentWeek(DateTime date)
    {
        int diff = (7 + (int)date.DayOfWeek - (int)DayOfWeek.Monday) % 7;
        currentWeekStart = date.AddDays(-1 * diff).Date;
    }

    private async Task LoadWeeklyEntries()
    {
        var weekEnd = currentWeekStart.AddDays(6);
        var entries = await WellnessService.GetByDateRangeAsync(currentWeekStart, weekEnd);
        weeklyEntries = entries.ToList();
    }

    private string GetRatingDescription(int rating) => rating switch
    {
        1 => "Muy baja",
        2 => "Baja",
        3 => "Normal",
        4 => "Alta",
        5 => "Muy alta",
        _ => "N/A"
    };

    private string GetMoodDescription(int rating) => rating switch
    {
        1 => "Muy mal",
        2 => "Mal",
        3 => "Neutral",
        4 => "Bien",
        5 => "Muy bien",
        _ => "N/A"
    };

    private string GetMoodIcon(int rating) => rating switch
    {
        1 => Icons.Material.Filled.SentimentVeryDissatisfied,
        2 => Icons.Material.Filled.SentimentDissatisfied,
        3 => Icons.Material.Filled.SentimentNeutral,
        4 => Icons.Material.Filled.SentimentSatisfied,
        5 => Icons.Material.Filled.SentimentVerySatisfied,
        _ => Icons.Material.Filled.QuestionMark
    };

    private Color GetMoodColor(int rating) => rating switch
    {
        1 => Color.Error,
        2 => Color.Warning,
        3 => Color.Info,
        4 => Color.Success,
        5 => Color.Primary,
        _ => Color.Default
    };

    private string GetEnergyIcon(int rating) => rating switch
    {
        1 => Icons.Material.Filled.BatteryAlert,
        2 => Icons.Material.Filled.Battery2Bar,
        3 => Icons.Material.Filled.Battery4Bar,
        4 => Icons.Material.Filled.Battery5Bar,
        5 => Icons.Material.Filled.BatteryFull,
        _ => Icons.Material.Filled.QuestionMark
    };

    private Color GetEnergyColor(int rating) => rating switch
    {
        1 => Color.Error,
        2 => Color.Warning,
        3 => Color.Info,
        4 => Color.Success,
        5 => Color.Primary,
        _ => Color.Default
    };
}