@page "/reports"
@using SegundoCerebro.BlazorWasm.Models
@using SegundoCerebro.BlazorWasm.Services
@inject IReportService ReportService
@inject IAccountService AccountService
@inject ISnackbar Snackbar
@inject IJSRuntime JSRuntime

<PageTitle>Reportes Financieros - SegundoCerebro</PageTitle>

<style>
    .kpi-card {
        background-color: var(--mud-palette-surface-dark) !important;
        position: relative;
        overflow: hidden;
        border: 1px solid rgba(255, 255, 255, 0.12);
        box-shadow: none !important;
    }
    .chart-panel {
        background-color: var(--mud-palette-surface-dark) !important;
        border: 1px solid rgba(255, 255, 255, 0.12);
        box-shadow: none !important;
    }
    .glow-bg-secondary {
        position: absolute;
        width: 100px;
        height: 100px;
        border-radius: 50%;
        filter: blur(30px);
        opacity: 0.1;
        pointer-events: none;
        background-color: var(--mud-palette-secondary);
        bottom: -20px;
        right: -20px;
    }
</style>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4 mb-8">
    <!-- Header -->
    <div class="d-flex flex-column flex-md-row align-center justify-space-between mb-6">
        <div>
            <MudText Typo="Typo.h4" Style="font-weight: 700; letter-spacing: -1px;">Reportes financieros</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">Análisis exhaustivo de flujos, márgenes operativos y distribución patrimonial consolidada.</MudText>
        </div>
        <div class="d-flex align-center gap-4 mt-4 mt-md-0">
            <MudSelect T="int" @bind-Value="SelectedPeriod" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Style="width: 250px;">
                <MudSelectItem Value="1">Últimos 30 días</MudSelectItem>
                <MudSelectItem Value="3">Último trimestre</MudSelectItem>
                <MudSelectItem Value="6">Últimos 6 meses</MudSelectItem>
                <MudSelectItem Value="12">Último año</MudSelectItem>
                <MudSelectItem Value="120">Todo el tiempo</MudSelectItem>
            </MudSelect>
            <MudMenu Label="@(isExporting ? "Generando..." : "Descargar Reporte")" Disabled="isExporting" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.FileDownload">
                <MudMenuItem OnClick='() => ExportReport("PDF")'>Formato PDF</MudMenuItem>
                <MudMenuItem OnClick='() => ExportReport("CSV")'>Formato Excel/CSV</MudMenuItem>
            </MudMenu>
        </div>
    </div>

    <!-- KPIs -->
    <MudGrid Spacing="3" Class="mb-6">
        <MudItem xs="12" sm="6" lg="3">
            <MudCard Class="kpi-card h-100 pa-4">
                <div class="glow-bg-secondary"></div>
                <div style="position: relative; z-index: 1;">
                    <div class="d-flex justify-space-between align-start mb-2">
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Style="text-transform: uppercase; font-weight: 600; letter-spacing: 1px;">Ratio de Ahorro Neto</MudText>
                        <MudIcon Icon="@Icons.Material.Filled.TrendingUp" Color="Color.Secondary" Size="Size.Small" />
                    </div>
                    <div class="d-flex align-baseline gap-1">
                        <MudText Typo="Typo.h3" Style="font-weight: 700;">@((summary?.TotalIncome > 0 ? (summary.NetIncome / summary.TotalIncome * 100) : 0).ToString("F1"))</MudText>
                        <MudText Typo="Typo.h5" Color="Color.Secondary" Style="font-weight: 700;">%</MudText>
                    </div>
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block mt-2">Margen neto acumulado</MudText>
                    <div class="mt-4" style="height: 6px; background-color: rgba(255,255,255,0.05); border-radius: 3px;">
                        <div style="width: 72%; height: 100%; background-color: var(--mud-palette-secondary); border-radius: 3px;"></div>
                    </div>
                </div>
            </MudCard>
        </MudItem>

        <MudItem xs="12" sm="6" lg="3">
            <MudCard Class="kpi-card h-100 pa-4">
                <div style="position: relative; z-index: 1;">
                    <div class="d-flex justify-space-between align-start mb-2">
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Style="text-transform: uppercase; font-weight: 600; letter-spacing: 1px;">Burn Rate Promedio</MudText>
                        <MudIcon Icon="@Icons.Material.Filled.LocalFireDepartment" Color="Color.Error" Size="Size.Small" />
                    </div>
                    <div class="d-flex align-baseline gap-1">
                        <MudText Typo="Typo.h3" Style="font-weight: 700;">@((summary?.TotalExpenses ?? 0).ToString("C0"))</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">/mes</MudText>
                    </div>
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block mt-2">Gasto operativo</MudText>
                    <div class="mt-4" style="height: 6px; background-color: rgba(255,255,255,0.05); border-radius: 3px;">
                        <div style="width: 48%; height: 100%; background-color: var(--mud-palette-primary); border-radius: 3px;"></div>
                    </div>
                </div>
            </MudCard>
        </MudItem>

        <MudItem xs="12" sm="6" lg="3">
            <MudCard Class="kpi-card h-100 pa-4">
                <div style="position: relative; z-index: 1;">
                    <div class="d-flex justify-space-between align-start mb-2">
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Style="text-transform: uppercase; font-weight: 600; letter-spacing: 1px;">Runway / Cojín Financiero</MudText>
                        <MudIcon Icon="@Icons.Material.Filled.HourglassTop" Color="Color.Primary" Size="Size.Small" />
                    </div>
                    <div class="d-flex align-baseline gap-1">
                        <MudText Typo="Typo.h3" Style="font-weight: 700;">@((summary?.TotalExpenses > 0 ? (summary.TotalBalance / summary.TotalExpenses) : 0).ToString("F1"))</MudText>
                        <MudText Typo="Typo.h5" Color="Color.Primary" Style="font-weight: 700;">Meses</MudText>
                    </div>
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block mt-2">Reserva segura</MudText>
                    <div class="mt-4" style="height: 6px; background-color: rgba(255,255,255,0.05); border-radius: 3px;">
                        <div style="width: 82%; height: 100%; background-color: var(--mud-palette-primary); border-radius: 3px;"></div>
                    </div>
                </div>
            </MudCard>
        </MudItem>

        <MudItem xs="12" sm="6" lg="3">
            <MudCard Class="kpi-card h-100 pa-4">
                <div style="position: relative; z-index: 1;">
                    <div class="d-flex justify-space-between align-start mb-2">
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Style="text-transform: uppercase; font-weight: 600; letter-spacing: 1px;">Eficiencia de Costos</MudText>
                        <MudIcon Icon="@Icons.Material.Filled.SmartToy" Color="Color.Tertiary" Size="Size.Small" />
                    </div>
                    <div class="d-flex align-baseline gap-1">
                        <MudText Typo="Typo.h3" Style="font-weight: 700;">@efficiencyScore.ToString("F0")</MudText>
                        <MudText Typo="Typo.h5" Color="Color.Tertiary" Style="font-weight: 700;">/100</MudText>
                    </div>
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block mt-2">@(efficiencyScore > 80 ? "Score Excelente" : (efficiencyScore > 50 ? "Score aceptable" : "Peligro de liquidez"))</MudText>
                    <div class="mt-4" style="height: 6px; background-color: rgba(255,255,255,0.05); border-radius: 3px;">
                        <div style="width: @(efficiencyScore.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))%; height: 100%; background-color: var(--mud-palette-tertiary); border-radius: 3px;"></div>
                    </div>
                </div>
            </MudCard>
        </MudItem>
    </MudGrid>

    <MudGrid Spacing="3" Class="mb-6">
        <!-- Area Chart: Ingresos vs Gastos -->
        <MudItem xs="12" lg="8">
            <MudCard Class="chart-panel h-100 pa-6">
                <div class="d-flex justify-space-between align-center mb-6">
                    <div>
                        <MudText Typo="Typo.h6" Style="font-weight: 700;">Evolución de Ingresos vs. Gastos</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Flujo de caja comparativo mensual (Julio - Diciembre 2023)</MudText>
                    </div>
                    <div class="d-flex gap-4">
                        <div class="d-flex align-center gap-2">
                            <div style="width: 12px; height: 12px; border-radius: 50%; background-color: var(--mud-palette-secondary);"></div>
                            <MudText Typo="Typo.body2">Ingresos</MudText>
                        </div>
                        <div class="d-flex align-center gap-2">
                            <div style="width: 12px; height: 12px; border-radius: 50%; background-color: var(--mud-palette-error);"></div>
                            <MudText Typo="Typo.body2">Gastos</MudText>
                        </div>
                    </div>
                </div>
                
                <div style="width: 100%; height: 320px; position: relative;">
                    @if (MonthlySeries.Any())
                    {
                        <MudChart ChartType="ChartType.Bar" ChartSeries="@MonthlySeries" XAxisLabels="@MonthlyLabels" Width="100%" Height="320px" ChartOptions="@options" />
                    }
                    else
                    {
                        <div class="d-flex align-center justify-center h-100">
                            <MudText Typo="Typo.body2" Color="Color.Secondary">No hay datos de tendencias para el periodo seleccionado.</MudText>
                        </div>
                    }
                </div>
            </MudCard>
        </MudItem>

        <!-- Category Donut -->
        <MudItem xs="12" lg="4">
            <MudCard Class="chart-panel h-100 pa-6 d-flex flex-column justify-space-between">
                <div>
                    <MudText Typo="Typo.h6" Style="font-weight: 700;">Distribución de gastos</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Desglose porcentual acumulado del trimestre</MudText>
                </div>
                
                <div class="my-4 d-flex justify-center" style="position: relative;">
                    <svg style="width: 200px; height: 200px; transform: rotate(-90deg);" viewBox="0 0 100 100">
                        <circle cx="50" cy="50" fill="transparent" r="38" stroke="rgba(255,255,255,0.05)" stroke-width="12"></circle>
                        @if (summary?.CategoryBreakdown != null && summary.CategoryBreakdown.Any())
                        {
                            double currentOffset = 0;
                            string[] colors = { "var(--mud-palette-primary)", "var(--mud-palette-secondary)", "var(--mud-palette-tertiary)", "var(--mud-palette-info)", "var(--mud-palette-warning)" };
                            int idx = 0;
                            foreach (var cat in summary.CategoryBreakdown.OrderByDescending(c => c.Percentage).Take(5))
                            {
                                double length = (double)(cat.Percentage / 100m) * 238.76;
                                <circle cx="50" cy="50" fill="transparent" r="38" stroke="@colors[idx % colors.Length]" stroke-dasharray="@(length.ToString(System.Globalization.CultureInfo.InvariantCulture)) 238.76" stroke-dashoffset="@((-currentOffset).ToString(System.Globalization.CultureInfo.InvariantCulture))" stroke-linecap="butt" stroke-width="12"></circle>
                                currentOffset += length;
                                idx++;
                            }
                        }
                    </svg>
                    <div style="position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; pointer-events: none;">
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Style="text-transform: uppercase;">Total</MudText>
                        <MudText Typo="Typo.h5" Style="font-weight: 700;">@((summary?.TotalExpenses ?? 0).ToString("C0"))</MudText>
                    </div>
                </div>

                <div class="d-flex flex-column gap-2 pt-4 border-t" style="border-color: rgba(255,255,255,0.12) !important;">
                    @if (summary?.CategoryBreakdown != null && summary.CategoryBreakdown.Any())
                    {
                        var topCategories = summary.CategoryBreakdown.OrderByDescending(c => c.Percentage).Take(4).ToList();
                        string[] colors = { "var(--mud-palette-primary)", "var(--mud-palette-secondary)", "var(--mud-palette-tertiary)", "var(--mud-palette-info)" };
                        
                        for (int i = 0; i < topCategories.Count; i++)
                        {
                            var cat = topCategories[i];
                            var col = colors[i % colors.Length];
                            <div class="d-flex justify-space-between align-center">
                                <div class="d-flex align-center gap-2">
                                    <div style="width: 10px; height: 10px; border-radius: 50%; background-color: @col;"></div>
                                    <MudText Typo="Typo.body2">@cat.CategoryName</MudText>
                                </div>
                                <MudText Typo="Typo.body2" Style="font-weight: 700;">@cat.Percentage.ToString("F0")%</MudText>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="d-flex align-center justify-center py-4">
                            <MudText Typo="Typo.body2" Color="Color.Secondary">Sin gastos categorizados.</MudText>
                        </div>
                    }
                </div>
            </MudCard>
        </MudItem>
    </MudGrid>

    <!-- Lower Bento Row: Liquidez -->
    <MudGrid Spacing="3">
        <MudItem xs="12" lg="7">
            <MudCard Class="chart-panel pa-6 h-100">
                <div class="d-flex justify-space-between align-center mb-6">
                    <div>
                        <MudText Typo="Typo.h6" Style="font-weight: 700;">Desglose de liquidez por institución</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Posiciones de capital líquido</MudText>
                    </div>
                    <MudChip T="string" Color="Color.Secondary" Style="font-weight: bold;">@((summary?.TotalBalance ?? 0).ToString("C0")) Total</MudChip>
                </div>

                <div class="d-flex flex-column gap-4">
                    @if(accounts != null && accounts.Any())
                    {
                        var totalBalance = accounts.Sum(a => Math.Max(0, a.Balance));
                        foreach(var account in accounts.OrderByDescending(a => a.Balance))
                        {
                            var pct = totalBalance > 0 ? (account.Balance / totalBalance) * 100 : 0;
                            var color = account.Balance >= 0 ? "var(--mud-palette-primary)" : "var(--mud-palette-error)";
                            
                            <div>
                                <div class="d-flex justify-space-between align-center mb-1">
                                    <div class="d-flex align-center gap-2">
                                        <MudIcon Icon="@Icons.Material.Filled.AccountBalance" Size="Size.Small" Style="@($"color: {color};")" />
                                        <MudText Typo="Typo.body2" Style="font-weight: 500;">@account.Name</MudText>
                                    </div>
                                    <div>
                                        <MudText Typo="Typo.body2" Style="font-weight: 700;">@account.Balance.ToString("C2")</MudText>
                                    </div>
                                </div>
                                <div style="height: 8px; background-color: rgba(255,255,255,0.05); border-radius: 4px;">
                                    <div style="height: 100%; width: @(Math.Max(0, pct).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))%; background-color: @color; border-radius: 4px;"></div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <MudText Typo="Typo.body2" Color="Color.Secondary">No hay cuentas activas.</MudText>
                    }
                </div>
            </MudCard>
        </MudItem>

        <MudItem xs="12" lg="5">
            <MudCard Class="chart-panel pa-6 h-100" Style="background-color: var(--mud-palette-surface) !important; position: relative; overflow: hidden;">
                <div class="glow-bg-secondary" style="background-color: var(--mud-palette-primary); top: -20px; right: -20px;"></div>
                <div style="position: relative; z-index: 1;">
                    <div class="d-flex justify-space-between align-center mb-4">
                        <div class="d-flex align-center gap-2">
                            <div class="pa-1 rounded" style="background-color: rgba(89, 74, 226, 0.2); color: var(--mud-palette-primary);">
                                <MudIcon Icon="@Icons.Material.Filled.Psychology" Size="Size.Small" />
                            </div>
                            <MudText Typo="Typo.h6" Style="font-weight: 700;">Insight predictivo</MudText>
                        </div>
                        <MudChip T="string" Size="Size.Small" Color="Color.Tertiary" Style="text-transform: uppercase;">IA Activa</MudChip>
                    </div>
                    
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
                        SegundoCerebro detectó que los gastos superan a los ingresos por <strong style="color: var(--mud-palette-error);">@((summary?.TotalExpenses - summary?.TotalIncome)?.ToString("C2") ?? "0")</strong>. 
                        Tus cuentas tienen saldo para soportar <strong style="color: var(--mud-palette-primary);">@((summary?.TotalExpenses > 0 ? (summary.TotalBalance / summary.TotalExpenses) : 0).ToString("F1")) meses</strong> de operaciones si se mantiene.
                    </MudText>
                    
                    <div class="pa-3 rounded-lg mb-4" style="background-color: rgba(255,255,255,0.03);">
                        <div class="d-flex align-center gap-1 mb-1" style="color: var(--mud-palette-secondary);">
                            <MudIcon Icon="@Icons.Material.Filled.Verified" Size="Size.Small" />
                            <MudText Typo="Typo.body2" Style="font-weight: 700;">Optimización recomendada:</MudText>
                        </div>
                        <MudText Typo="Typo.caption">
                            Auditar la categoría con mayores gastos podría reducir tu burn rate en un 15% mensual.
                        </MudText>
                    </div>

                    <div class="d-flex gap-2">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="flex-grow-1" StartIcon="@Icons.Material.Filled.AutoFixHigh" OnClick="ApplyOptimization" Disabled="@isApplyingOptimization">
                            @(isApplyingOptimization ? "Analizando..." : "Aplicar Optimización")
                        </MudButton>
                    </div>
                </div>
            </MudCard>
        </MudItem>
    </MudGrid>
</MudContainer>

@code {
    private FinancialSummaryDto? summary;
    private IEnumerable<AccountDto> accounts = new List<AccountDto>();
    private bool isExporting = false;
    private bool isApplyingOptimization = false;
    
    private double efficiencyScore => summary?.TotalIncome > 0 ? (double)Math.Min(100, Math.Max(0, 100 - (summary.TotalExpenses / summary.TotalIncome * 100m))) : 0;
    
    private List<ChartSeries> MonthlySeries = new();
    private string[] MonthlyLabels = Array.Empty<string>();
    private ChartOptions options = new ChartOptions { LineStrokeWidth = 3, InterpolationOption = InterpolationOption.Straight, YAxisTicks = 5, ChartPalette = new string[] { "#40e56c", "#ff4a4a" } };
    
    private int _selectedPeriod = 120; // Default to 'Todo el tiempo' (10 years)
    private int SelectedPeriod
    {
        get => _selectedPeriod;
        set
        {
            if (_selectedPeriod != value)
            {
                _selectedPeriod = value;
                _ = LoadData();
            }
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }
    
    private async Task LoadData()
    {
        try
        {
            var endDate = DateTime.Now;
            var startDate = endDate.AddMonths(-SelectedPeriod);
            summary = await ReportService.GetFinancialSummaryAsync(startDate, endDate);
            accounts = await AccountService.GetAllAsync();
            
            var trends = summary?.MonthlyTrends?.ToList() ?? new List<MonthlyTrendDto>();
            
            if (trends.Any())
            {
                if (trends.Count == 1)
                {
                    trends.Insert(0, new MonthlyTrendDto { MonthName = "", Income = 0, Expenses = 0 });
                    trends.Add(new MonthlyTrendDto { MonthName = " ", Income = 0, Expenses = 0 });
                }
                else if (trends.Count == 2)
                {
                    trends.Insert(0, new MonthlyTrendDto { MonthName = "", Income = 0, Expenses = 0 });
                }

                MonthlySeries = new List<ChartSeries>
                {
                    new ChartSeries() { Name = "Ingreso", Data = trends.Select(t => (double)t.Income).ToArray() },
                    new ChartSeries() { Name = "Gasto", Data = trends.Select(t => (double)t.Expenses).ToArray() }
                };
                MonthlyLabels = trends.Select(t => t.MonthName).ToArray();
            }
            else
            {
                MonthlySeries.Clear();
                MonthlyLabels = Array.Empty<string>();
            }
            
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Snackbar.Add("Error al cargar reportes: " + ex.Message, Severity.Error);
        }
    }
    
    private async Task ApplyOptimization()
    {
        isApplyingOptimization = true;
        StateHasChanged();
        Snackbar.Add("IA: Analizando tu estructura de gastos y calculando nuevos límites...", Severity.Info);
        
        await Task.Delay(2000);
        
        Snackbar.Add("Optimizaciones de presupuesto aplicadas con éxito. Se han ajustado los límites de tus categorías.", Severity.Success);
        isApplyingOptimization = false;
        StateHasChanged();
    }
    
    private async Task ExportReport(string format)
    {
        try
        {
            isExporting = true;
            Snackbar.Add($"Generando {format} consolidado...", Severity.Info);
            
            var endDate = DateTime.Now;
            var startDate = endDate.AddMonths(-SelectedPeriod);
            
            byte[] data;
            if (format == "PDF")
                data = await ReportService.ExportTransactionsToPdfAsync(startDate, endDate);
            else
                data = await ReportService.ExportTransactionsToExcelAsync(startDate, endDate);
                
            if (data != null)
            {
                var b64 = Convert.ToBase64String(data);
                var fileName = format == "PDF" ? "Reporte_Financiero.pdf" : "Reporte_Financiero.xlsx";
                var contentType = format == "PDF" ? "application/pdf" : "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet";
                
                await JSRuntime.InvokeVoidAsync("downloadFile", fileName, contentType, b64);
                Snackbar.Add($"Reporte {format} descargado correctamente.", Severity.Success);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add("Error al exportar: " + ex.Message, Severity.Error);
        }
        finally
        {
            isExporting = false;
        }
    }
}