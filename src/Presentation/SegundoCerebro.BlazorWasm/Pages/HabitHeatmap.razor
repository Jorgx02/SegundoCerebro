@page "/habits/heatmap"
@using SegundoCerebro.BlazorWasm.Models
@using SegundoCerebro.BlazorWasm.Services
@using SegundoCerebro.BlazorWasm.Components
@inject IHabitService HabitService
@inject ISnackbar Snackbar

<PageTitle>Análisis de Hábitos - SegundoCerebro</PageTitle>

<style>
    .card-outline {
        border: 1px solid var(--mud-palette-lines-default);
        background-color: var(--mud-palette-surface) !important;
        backdrop-filter: blur(12px);
    }
    
    .glow-bg {
        position: absolute;
        width: 250px;
        height: 250px;
        border-radius: 50%;
        filter: blur(100px);
        opacity: 0.15;
        pointer-events: none;
    }
</style>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4 mb-8">
    <!-- Header -->
    <div class="d-flex flex-column flex-md-row align-center justify-space-between mb-6">
        <div>
            <div class="d-flex align-center gap-2 mb-1" style="color: var(--mud-palette-primary); text-transform: uppercase; font-size: 12px; font-weight: 700; letter-spacing: 1px;">
                <MudText Typo="Typo.caption" Style="font-weight: 700; letter-spacing: 1px;">SegundoCerebro // Hábitos</MudText>
            </div>
            <MudText Typo="Typo.h4" Style="font-weight: 700;">Análisis y Heatmap</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">Visualiza la constancia y densidad de tus hábitos a lo largo del tiempo.</MudText>
        </div>
        <div class="d-flex align-center gap-4 mt-4 mt-md-0">
            <MudSelect T="int" @bind-Value="selectedYear" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Class="card-outline" Style="width: 140px;">
                @for (int year = DateTime.Today.Year; year >= DateTime.Today.Year - 5; year--)
                {
                    <MudSelectItem Value="@year" Text="@year.ToString()" />
                }
            </MudSelect>
        </div>
    </div>

    @if (loading)
    {
        <div class="d-flex justify-center align-center" style="height: 50vh;">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
        </div>
    }
    else if (heatmapData.Any())
    {
        <MudGrid Class="mt-4">
            @foreach (var habitData in heatmapData)
            {
                <MudItem xs="12">
                    <MudCard Class="card-outline pa-2" Style="position: relative; overflow: hidden;">
                        <div class="glow-bg" style="top: -50px; right: -50px; background-color: var(--mud-palette-primary);"></div>
                        
                        <MudCardHeader>
                            <CardHeaderContent>
                                <div class="d-flex align-center">
                                    <MudIcon Icon="@Icons.Material.Filled.CheckCircleOutline" Color="Color.Primary" Class="mr-3" />
                                    <MudText Typo="Typo.h6" Style="font-weight: 700;">@habitData.HabitName</MudText>
                                </div>
                            </CardHeaderContent>
                        </MudCardHeader>
                        <MudCardContent>
                            <HabitHeatmapGrid Year="selectedYear" CompletedDates="habitData.CompletedDates" />
                        </MudCardContent>
                    </MudCard>
                </MudItem>
            }
        </MudGrid>
    }
    else
    {
        <div class="pa-8 text-center card-outline rounded-lg mt-4">
            <MudIcon Icon="@Icons.Material.Filled.Timeline" Size="Size.Large" Color="Color.Secondary" Class="mb-3" />
            <MudText Typo="Typo.h6" Color="Color.Secondary">No hay datos de hábitos para este año</MudText>
        </div>
    }
</MudContainer>

@code {
    private bool loading = true;
    private List<HabitHeatmapDto> heatmapData = new();

    private int _selectedYear = DateTime.Today.Year;
    private int selectedYear
    {
        get => _selectedYear;
        set { if (_selectedYear != value) { _selectedYear = value; _ = LoadHeatmapData(); } }
    }

    protected override async Task OnInitializedAsync() => await LoadHeatmapData();

    private async Task LoadHeatmapData()
    {
        loading = true; StateHasChanged();
        try { heatmapData = (await HabitService.GetHeatmapDataAsync(selectedYear)).ToList(); }
        catch (Exception ex) { Snackbar.Add($"Error al cargar datos: {ex.Message}", Severity.Error); }
        finally { loading = false; StateHasChanged(); }
    }
}
