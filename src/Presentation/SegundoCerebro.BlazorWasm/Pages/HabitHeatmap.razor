@page "/habits/heatmap"
@using SegundoCerebro.BlazorWasm.Models
@using SegundoCerebro.BlazorWasm.Services
@using SegundoCerebro.BlazorWasm.Components
@inject IHabitService HabitService
@inject ISnackbar Snackbar

<PageTitle>Análisis de Hábitos - SegundoCerebro</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">
    <MudGrid>
        <MudItem xs="12" sm="6" Class="d-flex align-center">
            <MudText Typo="Typo.h4">Análisis de Hábitos</MudText>
        </MudItem>
        <MudItem xs="12" sm="6" Class="d-flex justify-end align-center">
            <MudSelect T="int" @bind-Value="selectedYear" Label="Año" Variant="Variant.Outlined" Margin="Margin.Dense"
                       Style="max-width: 120px;">
                @for (int year = DateTime.Today.Year; year >= DateTime.Today.Year - 5; year--)
                { // Usamos 'y' para evitar cualquier posible conflicto de nombres y Text explícito.
                  <MudSelectItem Value="@year" Text="@year.ToString()" />
                }
            </MudSelect>
        </MudItem>
    </MudGrid>

    @if (loading)
    {
        <div class="d-flex justify-center align-center" style="height: 50vh;">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
        </div>
    }
    else if (heatmapData.Any())
    {
        <MudGrid Class="mt-4">
            @foreach (var habitData in heatmapData)
            {
                <MudItem xs="12">
                    <MudCard Elevation="2" Class="rounded-lg">
                        <MudCardHeader>
                            <CardHeaderContent>
                                <MudText Typo="Typo.h6">@habitData.HabitName</MudText>
                            </CardHeaderContent>
                        </MudCardHeader>
                        <MudCardContent>
                            <HabitHeatmapGrid Year="selectedYear" CompletedDates="habitData.CompletedDates" />
                        </MudCardContent>
                    </MudCard>
                </MudItem>
            }
        </MudGrid>
    }
    else
    {
        <MudAlert Severity="MudBlazor.Severity.Info" Class="mt-4">No se encontraron hábitos para analizar.</MudAlert>
    }
</MudContainer>

@code {
    private bool loading = true;
    private List<HabitHeatmapDto> heatmapData = new();

    private int _selectedYear = DateTime.Today.Year;
    private int selectedYear
    {
        get => _selectedYear;
        set { if (_selectedYear != value) { _selectedYear = value; _ = LoadHeatmapData(); } }
    }

    protected override async Task OnInitializedAsync() => await LoadHeatmapData();

    private async Task LoadHeatmapData()
    {
        loading = true; StateHasChanged();
        try { heatmapData = (await HabitService.GetHeatmapDataAsync(selectedYear)).ToList(); }
        catch (Exception ex) { Snackbar.Add($"Error al cargar datos: {ex.Message}", MudSeverity.Error); }
        finally { loading = false; StateHasChanged(); }
    }
}
