@page "/calendar"
@using System.Globalization
@using SegundoCerebro.BlazorWasm.Models
@using SegundoCerebro.BlazorWasm.Services
@using MudBlazor
@inject ITodoItemService TodoItemService
@inject ISnackbar Snackbar
@inject NavigationManager NavigationManager

<PageTitle>Calendario - SegundoCerebro</PageTitle>

<style>
    .card-outline {
        border: 1px solid var(--mud-palette-lines-default);
        background-color: var(--mud-palette-surface) !important;
        backdrop-filter: blur(12px);
    }
    
    .glow-bg {
        position: absolute;
        width: 250px;
        height: 250px;
        border-radius: 50%;
        filter: blur(100px);
        opacity: 0.15;
        pointer-events: none;
    }

    .calendar-grid-container {
        display: grid;
        grid-template-columns: repeat(7, 1fr);
        grid-auto-rows: minmax(110px, 1fr);
        gap: 6px;
    }

    .calendar-day-cell {
        background-color: var(--mud-palette-background-grey);
        border: 1px solid var(--mud-palette-lines-default);
        border-radius: 8px;
        transition: all 0.2s ease;
    }
    
    .calendar-day-cell:hover {
        background-color: var(--mud-palette-action-hover);
        border: 1px solid var(--mud-palette-lines-inputs);
    }
    
    .calendar-day-cell.current-month {
        background-color: var(--mud-palette-surface);
    }
    
    .calendar-day-cell.today {
        border: 1px solid var(--mud-palette-primary) !important;
        background-color: rgba(var(--mud-palette-primary-rgb), 0.05);
    }

    .task-chip {
        cursor: pointer;
        font-size: 0.75rem;
        font-weight: 600;
        border-radius: 4px;
        padding: 4px 6px;
        margin-bottom: 4px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        background-color: var(--mud-palette-action-hover);
        border-left: 3px solid transparent;
        transition: opacity 0.2s;
    }
    .task-chip:hover {
        opacity: 0.8;
    }
    .task-chip.success { border-left-color: var(--mud-palette-success); color: var(--mud-palette-success-darken); }
    .task-chip.error { border-left-color: var(--mud-palette-error); color: var(--mud-palette-error-darken); }
    .task-chip.primary { border-left-color: var(--mud-palette-primary); color: var(--mud-palette-primary-darken); }
</style>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4 mb-8">
    <!-- Header -->
    <div class="d-flex flex-column flex-md-row align-center justify-space-between mb-6">
        <div>
            <MudText Typo="Typo.h4" Style="font-weight: 700;">Calendario</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">Vista panorámica de entregas y compromisos a corto plazo.</MudText>
        </div>
        <div class="d-flex align-center gap-4 mt-4 mt-md-0">
            <div class="card-outline rounded-lg d-flex align-center px-2 py-1">
                <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft" OnClick="PreviousMonth" Size="Size.Small" />
                <MudText Typo="Typo.h6" Class="mx-4" Style="min-width: 150px; text-align: center; text-transform: capitalize; font-weight: 600;">
                    @currentMonth.ToString("MMMM yyyy", new CultureInfo("es-ES"))
                </MudText>
                <MudIconButton Icon="@Icons.Material.Filled.ChevronRight" OnClick="NextMonth" Size="Size.Small" />
            </div>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="GoToToday">
                Ir a Hoy
            </MudButton>
        </div>
    </div>

    @if (loading)
    {
        <div class="d-flex justify-center align-center" style="height: 50vh;">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
        </div>
    }
    else
    {
        <MudCard Class="card-outline pa-4" Style="position: relative; overflow: hidden;">
            <div class="glow-bg" style="top: 10%; right: 10%; background-color: var(--mud-palette-primary);"></div>
            
            <div class="calendar-grid-container" style="position: relative; z-index: 1;">
                <!-- Day Headers -->
                @foreach (var dayName in dayNames)
                {
                    <div class="pa-2 text-center" style="font-weight: 700; color: var(--mud-palette-secondary); font-size: 0.85rem; letter-spacing: 1px;">
                        @dayName
                    </div>
                }

                <!-- Day Cells -->
                @{
                    var firstDayOfMonth = new DateTime(currentMonth.Year, currentMonth.Month, 1);
                    int daysToPad = (int)firstDayOfMonth.DayOfWeek - (int)DayOfWeek.Monday;
                    if (daysToPad < 0) daysToPad += 7;
                    var calendarStartDate = firstDayOfMonth.AddDays(-daysToPad);
                }

                @for (int i = 0; i < 42; i++)
                {
                    var day = calendarStartDate.AddDays(i);
                    var isCurrentMonth = day.Month == currentMonth.Month;
                    var isToday = day.Date == DateTime.Today;
                    var cellClass = "calendar-day-cell pa-2 d-flex flex-column";
                    if (isCurrentMonth) cellClass += " current-month";
                    if (isToday) cellClass += " today";

                    <div class="@cellClass">
                        <div class="d-flex justify-end mb-1">
                            <MudText Typo="Typo.caption" Style="@(isToday ? "font-weight: 800; color: var(--mud-palette-primary); background: rgba(var(--mud-palette-primary-rgb), 0.2); border-radius: 50%; width: 24px; height: 24px; display: flex; align-items: center; justify-content: center;" : (isCurrentMonth ? "font-weight: 600;" : "color: var(--mud-palette-text-disabled);"))">
                                @day.Day
                            </MudText>
                        </div>
                        <div class="flex-grow-1 overflow-y-auto" style="scrollbar-width: none;">
                            @foreach (var task in GetTasksForDate(day))
                            {
                                <MudTooltip Text="@($"{task.Title} - {task.ProjectName}")" Delay="300">
                                    <div class="task-chip @GetTaskColorClass(task)" @onclick="() => NavigateToProject(task.ProjectId)">
                                        @task.Title
                                    </div>
                                </MudTooltip>
                            }
                        </div>
                    </div>
                }
            </div>
        </MudCard>
    }
</MudContainer>

@code {
    private List<TodoItemDto> tasksWithDueDate = new();
    private bool loading = true;
    private DateTime currentMonth = DateTime.Today;

    private readonly string[] dayNames = new CultureInfo("es-ES").DateTimeFormat.AbbreviatedDayNames
        .Select((day, index) => new { day, index })
        .OrderBy(x => (x.index + 6) % 7) // Start week on Monday
        .Select(x => x.day.ToUpper())
        .ToArray();

    protected override async Task OnInitializedAsync()
    {
        loading = true;
        try
        {
            var allTasks = await TodoItemService.GetAllAsync();
            tasksWithDueDate = allTasks?.Where(t => t.DueDate.HasValue).ToList() ?? new List<TodoItemDto>();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al cargar las tareas: {ex.Message}", Severity.Error);
        }
        finally
        {
            loading = false;
        }
    }

    private void PreviousMonth()
    {
        currentMonth = currentMonth.AddMonths(-1);
    }

    private void NextMonth()
    {
        currentMonth = currentMonth.AddMonths(1);
    }

    private void GoToToday()
    {
        currentMonth = DateTime.Today;
    }

    private IEnumerable<TodoItemDto> GetTasksForDate(DateTime date)
    {
        return tasksWithDueDate.Where(t => t.DueDate.HasValue && t.DueDate.Value.Date == date.Date);
    }

    private string GetTaskColorClass(TodoItemDto task)
    {
        if (task.Status == Models.Enums.TodoItemStatus.Completed)
            return "success";
        if (task.DueDate.HasValue && task.DueDate.Value.Date < DateTime.Today.Date)
            return "error";
        return "primary";
    }

    private void NavigateToProject(Guid? projectId)
    {
        if (projectId.HasValue)
        {
            NavigationManager.NavigateTo($"/projects/{projectId.Value}");
        }
    }
}