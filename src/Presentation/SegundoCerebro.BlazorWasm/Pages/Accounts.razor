    {
        var parameters = new DialogParameters { ["Account"] = account };
        var dialog = DialogService.Show<ChangeCurrencyDialog>("Cambiar Divisa", parameters);
        var result = await dialog.Result;

        if (!result.Canceled && result.Data != null)
        {
            try
