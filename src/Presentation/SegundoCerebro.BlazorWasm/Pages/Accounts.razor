@page "/accounts"
@using SegundoCerebro.BlazorWasm.Models
@using SegundoCerebro.BlazorWasm.Models.Enums
@using SegundoCerebro.BlazorWasm.Services
@inject IAccountService AccountService
@inject ISnackbar Snackbar
@inject IDialogService DialogService

@* Título de la página que se mostrará en la pestaña del navegador. *@
<PageTitle>Cuentas - SegundoCerebro</PageTitle>

<style>
    .bento-card {
        background-color: rgba(255, 255, 255, 0.02);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 12px;
        position: relative;
        overflow: hidden;
        height: 100%;
        padding: 24px;
    }
    .bento-card-bg-icon {
        position: absolute;
        right: -16px;
        top: -16px;
        width: 96px;
        height: 96px;
        background-color: rgba(89, 74, 226, 0.05);
        border-radius: 50%;
        filter: blur(20px);
        transition: background-color 0.3s;
    }
    .bento-card:hover .bento-card-bg-icon {
        background-color: rgba(89, 74, 226, 0.1);
    }
    .icon-container {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background-color: rgba(255, 255, 255, 0.05);
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .accounts-table-card {
        background-color: rgba(255, 255, 255, 0.02);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 12px;
        box-shadow: none !important;
    }
</style>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4 mb-8">
    <div class="d-flex justify-space-between align-center mb-6">
        <div>
            <MudText Typo="Typo.h4" Style="font-weight: 700;">Cuentas</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">Controla tu capital financiero.</MudText>
        </div>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenCreateDialog">
            Nueva Cuenta
        </MudButton>
    </div>

    <!-- Summary Cards -->
    <MudGrid Class="mb-6" Spacing="3">
        <MudItem xs="12" md="4">
            <div class="bento-card">
                <div class="bento-card-bg-icon"></div>
                <div class="d-flex justify-space-between align-start position-relative" style="z-index: 10;">
                    <div>
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Style="text-transform: uppercase; letter-spacing: 1px;">Saldo total</MudText>
                        <MudText Typo="Typo.h4" Style="font-weight: 700; margin-top: 4px;" Color="@(totalBalance >= 0 ? Color.Default : Color.Error)">@totalBalance.ToString("N2")</MudText>
                    </div>
                    <div class="icon-container">
                        <MudIcon Icon="@Icons.Material.Filled.AccountBalanceWallet" Color="Color.Primary" />
                    </div>
                </div>
            </div>
        </MudItem>
        <MudItem xs="12" md="4">
            <div class="bento-card">
                <div class="d-flex justify-space-between align-start position-relative" style="z-index: 10;">
                    <div>
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Style="text-transform: uppercase; letter-spacing: 1px;">Cuentas activas</MudText>
                        <MudText Typo="Typo.h4" Style="font-weight: 700; margin-top: 4px;">@allAccounts.Count(a => a.IsActive)</MudText>
                    </div>
                    <div class="icon-container">
                        <MudIcon Icon="@Icons.Material.Filled.CreditCard" Color="Color.Primary" />
                    </div>
                </div>
                <div class="d-flex gap-2 mt-4 position-relative" style="z-index: 10;">
                    <MudChip Size="Size.Small" Color="Color.Secondary" Variant="Variant.Text" Style="background-color: rgba(0, 200, 83, 0.15); font-weight: 700;">@allAccounts.Count(a => a.IsActive && a.Type == AccountType.Checking) NORMAL</MudChip>
                    <MudChip Size="Size.Small" Color="Color.Info" Variant="Variant.Text" Style="background-color: rgba(33, 150, 243, 0.15); font-weight: 700;">@allAccounts.Count(a => a.IsActive && a.Type == AccountType.Savings) AHORROS</MudChip>
                </div>
            </div>
        </MudItem>
        <MudItem xs="12" md="4">
            <div class="bento-card">
                <div class="d-flex justify-space-between align-start position-relative" style="z-index: 10;">
                    <div>
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Style="text-transform: uppercase; letter-spacing: 1px;">Total Ahorros</MudText>
                        <MudText Typo="Typo.h4" Style="font-weight: 700; margin-top: 4px;">@allAccounts.Where(a => a.IsActive && a.Type == AccountType.Savings).Sum(a => a.Balance).ToString("N2")</MudText>
                    </div>
                    <div class="icon-container">
                        <MudIcon Icon="@Icons.Material.Filled.Savings" Color="Color.Tertiary" />
                    </div>
                </div>
            </div>
        </MudItem>
    </MudGrid>

    <MudCard Class="accounts-table-card">
        <MudCardHeader Class="border-b" Style="border-color: rgba(255,255,255,0.12) !important;">
            <CardHeaderContent>
                <div class="d-flex justify-space-between align-center">
                    <MudText Typo="Typo.h6" Style="font-weight: 700;">Cuentas</MudText>
                    <MudSelect T="AccountStatusFilter" Value="statusFilter" ValueChanged="OnStatusFilterChanged"
                               Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true"
                               Style="width: 150px; background-color: var(--mud-palette-surface); border-radius: 8px;">
                        <MudSelectItem Value="AccountStatusFilter.Active">Activas</MudSelectItem>
                        <MudSelectItem Value="AccountStatusFilter.Inactive">Inactivas</MudSelectItem>
                        <MudSelectItem Value="AccountStatusFilter.All">Todas</MudSelectItem>
                    </MudSelect>
                </div>
            </CardHeaderContent>
        </MudCardHeader>
        <MudCardContent Class="pa-0">
            <MudTable Items="@FilteredAccounts" Hover="true" Dense="false" Elevation="0" Style="background-color: transparent;" Loading="@loading" LoadingProgressColor="Color.Info">
                <HeaderContent>
                    <MudTh><MudText Typo="Typo.caption" Color="Color.Secondary" Style="font-weight: 700; text-transform: uppercase;">Fav</MudText></MudTh>
                    <MudTh><MudText Typo="Typo.caption" Color="Color.Secondary" Style="font-weight: 700; text-transform: uppercase;">Cuenta</MudText></MudTh>
                    <MudTh><MudText Typo="Typo.caption" Color="Color.Secondary" Style="font-weight: 700; text-transform: uppercase;">Tipo</MudText></MudTh>
                    <MudTh><MudText Typo="Typo.caption" Color="Color.Secondary" Style="font-weight: 700; text-transform: uppercase;">Banco</MudText></MudTh>
                    <MudTh Style="text-align: right;"><MudText Typo="Typo.caption" Color="Color.Secondary" Style="font-weight: 700; text-transform: uppercase;">Balance</MudText></MudTh>
                    <MudTh Style="text-align: center;"><MudText Typo="Typo.caption" Color="Color.Secondary" Style="font-weight: 700; text-transform: uppercase;">Estado</MudText></MudTh>
                    <MudTh Style="text-align: right;"><MudText Typo="Typo.caption" Color="Color.Secondary" Style="font-weight: 700; text-transform: uppercase;">Acciones</MudText></MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Fav" Style="width: 50px; text-align: center;">
                        <MudIconButton Icon="@(context.IsFavorite ? Icons.Material.Filled.Star : Icons.Material.Filled.StarBorder)"
                                       Color="@(context.IsFavorite ? Color.Warning : Color.Secondary)" Size="Size.Small" OnClick="() => ToggleFavoriteStatus(context)" />
                    </MudTd>
                    <MudTd DataLabel="Cuenta">
                        <div class="d-flex align-center gap-3">
                            <div class="icon-container" style="width: 32px; height: 32px; border: 1px solid rgba(255,255,255,0.1);">
                                <MudIcon Icon="@GetAccountIcon(context.Type)" Color="@GetTypeColor(context.Type)" Size="Size.Small" />
                            </div>
                            <div>
                                <MudLink Href="@($"/accounts/{context.Id}")" Typo="Typo.body2" Color="Color.Default" Underline="Underline.None" Style="font-weight: 700;">
                                    @context.Name
                                </MudLink>
                                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block">@(string.IsNullOrEmpty(context.Description) ? "Cuenta" : context.Description)</MudText>
                            </div>
                        </div>
                    </MudTd>
                    <MudTd DataLabel="Tipo">
                        <MudChip Size="Size.Small" Color="@GetTypeColor(context.Type)" Variant="Variant.Outlined" Style="font-size: 10px; font-weight: 700; text-transform: uppercase; border-color: rgba(255,255,255,0.12);">
                            @context.TypeName
                        </MudChip>
                    </MudTd>
                    <MudTd DataLabel="Banco">
                        <MudText Typo="Typo.body2">@(context.BankName ?? "-")</MudText>
                    </MudTd>
                    <MudTd DataLabel="Balance" Style="text-align: right;">
                        <MudText Typo="Typo.body2" Style="font-family: monospace; font-weight: 700;" Color="@(context.Balance >= 0 ? Color.Default : Color.Error)">
                            @context.Balance.ToString("N2")
                        </MudText>
                    </MudTd>
                    <MudTd DataLabel="Estado" Style="text-align: center;">
                        <MudChip Size="Size.Small" Color="@(context.IsActive ? Color.Secondary : Color.Default)" Variant="Variant.Text" Style="@(context.IsActive ? "background-color: rgba(0, 200, 83, 0.15); font-weight: 700;" : "background-color: rgba(255,255,255,0.1); font-weight: 700;")">
                            @(context.IsActive ? "ACTIVE" : "INACTIVE")
                        </MudChip>
                    </MudTd>
                    <MudTd DataLabel="Acciones" Style="text-align: right;">
                        <MudMenu Icon="@Icons.Material.Filled.MoreVert" Size="Size.Small" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                            <MudMenuItem OnClick="() => OpenEditDialog(context)" Icon="@Icons.Material.Filled.Edit">Editar</MudMenuItem>
                            <MudMenuItem OnClick="() => DeleteAccount(context)" Icon="@Icons.Material.Filled.Delete" IconColor="Color.Error">Eliminar</MudMenuItem>
                        </MudMenu>
                    </MudTd>
                </RowTemplate>
            </MudTable>
        </MudCardContent>
    </MudCard>
</MudContainer>

@code {
    /// <summary>
    /// Lista que almacena todas las cuentas obtenidas del servicio.
    /// </summary>
    private List<AccountDto> allAccounts = new();

    /// <summary>
    /// Almacena el saldo total combinado de todas las cuentas activas.
    /// </summary>
    private decimal totalBalance = 0;

    /// <summary>
    /// Indicador booleano para controlar el estado de carga de la tabla.
    /// </summary>
    private bool loading = true;

    /// <summary>
    /// Almacena el valor actual del filtro de estado de la cuenta (Activas, Inactivas, Todas).
    /// </summary>
    private AccountStatusFilter statusFilter = AccountStatusFilter.Active;

    /// <summary>
    /// Enumeración para definir los posibles estados de filtro de la tabla de cuentas.
    /// </summary>
    private enum AccountStatusFilter { All, Active, Inactive }

    /// <summary>
    /// Se ejecuta cuando el usuario cambia el valor del filtro de estado.
    /// </summary>
    private void OnStatusFilterChanged(AccountStatusFilter newValue)
    {
        statusFilter = newValue;
        StateHasChanged();
    }

    /// <summary>
    /// Propiedad computada que devuelve la lista de cuentas filtrada según el valor de `statusFilter`.
    /// </summary>
    private IEnumerable<AccountDto> FilteredAccounts
    {
        get
        {
            var accounts = statusFilter switch
            {
                AccountStatusFilter.Active => allAccounts.Where(a => a.IsActive),
                AccountStatusFilter.Inactive => allAccounts.Where(a => !a.IsActive),
                _ => allAccounts
            };
            return accounts.OrderByDescending(a => a.IsFavorite).ThenBy(a => a.Name);
        }
    }

    /// <summary>
    /// Método del ciclo de vida de Blazor que se ejecuta al inicializar la página.
    /// Llama a `LoadAccounts` para cargar los datos iniciales.
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        await LoadAccounts();
    }

    /// <summary>
    /// Carga todas las cuentas desde el servicio API, calcula el balance total
    /// y gestiona el estado de carga de la UI.
    /// </summary>
    private async Task LoadAccounts()
    {
        loading = true;
        try
        {
            var result = await AccountService.GetAllAsync();
            allAccounts = result?.ToList() ?? new List<AccountDto>();
            totalBalance = await AccountService.GetTotalBalanceAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error cargando cuentas: {ex.Message}", Severity.Error);
        }
        finally
        {
            loading = false;
        }
    }

    /// <summary>
    /// Llama al servicio para cambiar el estado de favorito de una cuenta y actualiza la UI.
    /// </summary>
    /// <param name="account">La cuenta a modificar.</param>
    private async Task ToggleFavoriteStatus(AccountDto account)
    {
        try
        {
            await AccountService.ToggleFavoriteAsync(account.Id);
            account.IsFavorite = !account.IsFavorite; // Actualiza el estado local para reflejo inmediato en la UI
            Snackbar.Add("Estado de favorito actualizado.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error actualizando el estado de favorito: {ex.Message}", Severity.Error);
        }
        // StateHasChanged se invoca automáticamente por el evento OnClick
    }

    /// <summary>
    /// Devuelve el icono correspondiente a un tipo de cuenta.
    /// </summary>
    /// <param name="type">El tipo de cuenta.</param>
    private String GetAccountIcon(AccountType type) => type switch
    {
        AccountType.Checking => Icons.Material.Filled.Payment,
        AccountType.Savings => Icons.Material.Filled.Savings,
        AccountType.Investment => Icons.Material.Filled.TrendingUp,
        AccountType.Cash => Icons.Material.Filled.Money,
        _ => Icons.Material.Filled.AccountBalance
    };

    /// <summary>
    /// Devuelve el color de MudBlazor correspondiente a un tipo de cuenta para usar en los chips.
    /// </summary>
    /// <param name="type">El tipo de cuenta.</param>
    private Color GetTypeColor(AccountType type) => type switch
    {
        AccountType.Checking => Color.Primary,
        AccountType.Savings => Color.Info,
        AccountType.Investment => Color.Secondary,
        AccountType.Cash => Color.Success,
        _ => Color.Default
    };

    /// <summary>
    /// Abre el diálogo para crear una nueva cuenta.
    /// Si la creación es exitosa, recarga la lista de cuentas.
    /// </summary>
    private async Task OpenCreateDialog()
    {
        var dialog = DialogService.Show<CreateAccountDialog>("Crear nueva cuenta");
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            await LoadAccounts();
            Snackbar.Add("Cuenta creada con éxito", Severity.Success);
        }
    }

    /// <summary>
    /// Abre el diálogo para editar una cuenta existente.
    /// </summary>
    /// <param name="account">La cuenta a editar.</param>
    /// <remarks>Si la edición es exitosa, recarga la lista de cuentas.</remarks>
    private async Task OpenEditDialog(AccountDto account)
    {
        var parameters = new DialogParameters { ["Account"] = account };
        var dialog = DialogService.Show<EditAccountDialog>("Editar cuenta", parameters);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            await LoadAccounts();
            Snackbar.Add("Cuenta actualizada con éxito", Severity.Success);
        }
    }

    /// <summary>
    /// Gestiona la lógica para desactivar (soft delete) una cuenta.
    /// - Si la cuenta tiene saldo positivo, abre un diálogo para transferir los fondos.
    // - Si tiene saldo cero, pide confirmación para desactivarla.
    /// </summary>
    /// <param name="account">La cuenta a desactivar.</param>
    private async Task DeleteAccount(AccountDto account)
    {
        if (account.Balance < 0)
        {
            Snackbar.Add("No se puede desactivar una cuenta con saldo negativo.", Severity.Error);
            return;
        }

        if (!account.IsActive && account.Balance == 0)
        {
            Snackbar.Add("La cuenta ya se encuentra inactiva y vacía.", Severity.Info);
            return;
        }

        if (account.Balance > 0)
        {
            var parameters = new DialogParameters
            {
                ["AccountToDelete"] = account,
                ["AvailableAccounts"] = allAccounts.Where(a => a.Id != account.Id && a.IsActive).ToList()
            };
            var dialog = DialogService.Show<TransferAndDeleteDialog>("Transferir fondos y desactivar", parameters);
            var dialogResult = await dialog.Result;
            if (!dialogResult.Canceled) await LoadAccounts();
            return;
        }

        bool? result = await DialogService.ShowMessageBox(
            "Desactivar cuenta",
            $"¿Estás seguro de que deseas desactivar la cuenta '{account.Name}'?",
            yesText: "Desactivar",
            cancelText: "Cancelar");

        if (result == true)
        {
            try
            {
                var updateDto = new UpdateAccountDto
                {
                    Name = account.Name,
                    Description = account.Description,
                    Type = account.Type,
                    Currency = account.Currency,
                    AccountNumber = account.AccountNumber,
                    BankName = account.BankName,
                    IsActive = false,
                    Balance = 0
                };
                await AccountService.UpdateAsync(account.Id, updateDto);

                await LoadAccounts();
                Snackbar.Add("Cuenta desactivada correctamente.", Severity.Success);
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Error al desactivar la cuenta: {ex.Message}", Severity.Error);
            }
        }
    }

