@using SegundoCerebro.BlazorWasm.Models
@using SegundoCerebro.BlazorWasm.Models.Enums
@using SegundoCerebro.BlazorWasm.Services
@inject ICategoryService CategoryService
@inject IAccountService AccountService
@inject ITransactionService TransactionService

<MudDialog Style="background-color: var(--mud-palette-surface); border: 1px solid rgba(255, 255, 255, 0.12);">
    <TitleContent>
        <MudText Typo="Typo.h6" Style="font-weight: 700; color: var(--mud-palette-primary);">
            <MudIcon Icon="@Icons.Material.Filled.Add" Class="mr-2" /> Nueva Transacción
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudForm @ref="form" @bind-IsValid="isValid">
            <MudGrid>
                <MudItem xs="12">
                    <MudTextField @bind-Value="model.Description" Label="Descripción" Required="true" Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudNumericField @bind-Value="model.Amount" Label="Monto" Required="true" Variant="Variant.Outlined" Format="N2" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Euro" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudSelect @bind-Value="model.Type" Label="Tipo" Required="true" Variant="Variant.Outlined">
                        <MudSelectItem Value="TransactionType.Income">Ingreso</MudSelectItem>
                        <MudSelectItem Value="TransactionType.Expense">Gasto</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudSelect @bind-Value="model.AccountId" Label="Cuenta" Required="true" Variant="Variant.Outlined">
                        @foreach (var acc in accounts)
                        {
                            <MudSelectItem Value="acc.Id">@acc.Name</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudSelect @bind-Value="model.CategoryId" Label="Categoría" Required="true" Variant="Variant.Outlined">
                        @foreach (var cat in categories.Where(c => (int)c.Type == (int)model.Type))
                        {
                            <MudSelectItem Value="cat.Id">@cat.Name</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12">
                    <MudDatePicker Date="model.Date" DateChanged="@((DateTime? d) => model.Date = d ?? DateTime.Today)" Label="Fecha" Required="true" Variant="Variant.Outlined" />
                </MudItem>
            </MudGrid>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Color="Color.Secondary">Cancelar</MudButton>
        <MudButton OnClick="Submit" Color="Color.Primary" Variant="Variant.Filled" Disabled="@(!isValid || isSubmitting)">
            @if (isSubmitting)
            {
                <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                <MudText Class="ms-2">Guardando</MudText>
            }
            else
            {
                <MudText>Guardar</MudText>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] MudDialogInstance MudDialog { get; set; } = null!;

    private MudForm form = null!;
    private bool isValid;
    private bool isSubmitting;

    private CreateTransactionDto model = new() { Date = DateTime.Today, Type = TransactionType.Expense };
    private IEnumerable<AccountDto> accounts = new List<AccountDto>();
    private IEnumerable<CategoryDto> categories = new List<CategoryDto>();

    protected override async Task OnInitializedAsync()
    {
        accounts = await AccountService.GetAllAsync();
        categories = await CategoryService.GetAllAsync();
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task Submit()
    {
        await form.Validate();
        if (isValid)
        {
            isSubmitting = true;
            StateHasChanged();
            
            try
            {
                var result = await TransactionService.CreateAsync(model);
                MudDialog.Close(DialogResult.Ok(result));
            }
            finally
            {
                isSubmitting = false;
            }
        }
    }
}
