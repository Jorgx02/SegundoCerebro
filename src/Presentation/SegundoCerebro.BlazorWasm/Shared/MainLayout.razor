@inherits LayoutComponentBase
@using MudBlazor

<MudThemeProvider Theme="_currentTheme" @bind-IsDarkMode="_isDarkMode" />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1" Color="Color.Primary">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start"
                       OnClick="@((e) => DrawerToggle())" />
        <MudIcon Icon="@Icons.Material.Filled.Psychology" Size="Size.Large" Class="ml-2 mr-2" />
        <MudText Typo="Typo.h5" Style="font-weight: 700;">SegundoCerebro</MudText>
        <MudSpacer />
        <MudIconButton Icon="@(_isDarkMode ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)"
                       Color="Color.Inherit" OnClick="ToggleDarkMode" Title="Cambiar Tema" />
        <AuthorizeView>
            <Authorized>
                <MudIconButton Href="/logout" Icon="@Icons.Material.Filled.Logout" Color="Color.Inherit" Class="mr-4"
                               Title="Cerrar Sesión" />
                <a href="/profile" style="text-decoration: none;">
                    <MudAvatar Color="Color.Secondary" Variant="Variant.Filled" Style="cursor: pointer;"
                               Title="Mi Perfil">
                        @(context.User.Claims.FirstOrDefault(c => c.Type ==
                        System.Security.Claims.ClaimTypes.Name)?.Value.FirstOrDefault().ToString().ToUpper() ??
                          context.User.Claims.FirstOrDefault(c => c.Type ==
                        System.Security.Claims.ClaimTypes.Email)?.Value.FirstOrDefault().ToString().ToUpper() ?? "U")
                    </MudAvatar>
                </a>
            </Authorized>
        </AuthorizeView>
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen" Elevation="2" ClipMode="DrawerClipMode.Always">
        <div class="mt-4"></div>
        <NavMenu />
    </MudDrawer>

    <MudMainContent Style="background-color: var(--mud-palette-background-grey); min-height: 100vh;">
        <MudContainer MaxWidth="MaxWidth.Large" Class="pt-6 pb-12">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    bool _drawerOpen = true;
    bool _isDarkMode = true;

    void DrawerToggle()
    {
        _drawerOpen = !_drawerOpen;
    }

    void ToggleDarkMode()
    {
        _isDarkMode = !_isDarkMode;
    }

    private MudTheme _currentTheme = new MudTheme()
    {
        Palette = new PaletteLight()
        {
            Primary = "#594ae2", 
            Secondary = "#00C853",
            Tertiary = "#FF9800",
            AppbarBackground = "#ffffff",
            Background = "#f4f6f8", 
            DrawerBackground = "#ffffff"
        },
        PaletteDark = new PaletteDark()
        {
            Primary = "#594ae2", 
            Secondary = "#00C853",
            Tertiary = "#FF9800",
            Error = "#ffb4ab",
            AppbarBackground = "#121212",
            Background = "#121212",
            Surface = "#1e1e1e",
            DrawerBackground = "#121212",
            TextPrimary = "#ffffff",
            TextSecondary = "#b2b0bf"
        },
        LayoutProperties = new LayoutProperties()
        {
            DefaultBorderRadius = "12px" 
        }
    };
}